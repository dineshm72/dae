{
   "name": "dae",
   "title": "Dynamic effects using Active Effects (DAE)",
   "description": "Replacement for dynamic effects",
   "version": "13.0.34",
   "scripts": {
      "package": "gulp package",
    "release": "gulp release",
      "build": "gulp build --dbg",
      "build:link": "gulp build --dbg && gulp link",
      "build:watch": "gulp watch",
      "build:bundle": "gulp bundle --dbg",
      "clean": "gulp clean && gulp link --clean",
      "prettier-format": "prettier --config .prettierrc --write \"./src/**/*.{ts,js,json,scss,css}\"",
      "tag": "git remote get-url origin | grep -q github.com || { echo 'origin is not GitHub: tags must never reach GitLab'; exit 1; }; V=$(jq -r .version package.json) && git tag -a v$V -m \"version $V release tag\" && git push origin v$V"
   },
   "keywords": [
      "foundryvtt",
      "fvtt",
      "module"
   ],
   "author": "",
   "license": "SEE LICENSE IN LICENSE",
   "devDependencies": {
      "@types/archiver": "^5.1.1",
      "@types/gulp": "^4.0.9",
      "@types/gulp-less": "^0.0.32",
      "@types/jquery": "^3.5.14",
      "@types/yargs": "^17.0.2",
      "@typescript-eslint/parser": "^4.33.0",
      "archiver": "^5.3.0",
      "eslint": "^7.32.0",
      "eslint-config-prettier": "^8.5.0",
      "eslint-plugin-import": "^2.26.0",
      "eslint-plugin-prettier": "^3.4.0",
      "fvtt-types": "github:League-of-Foundry-Developers/foundry-vtt-types#main",
      "gulp": "^4.0.2",
      "gulp-concat": "^2.6.1",
      "gulp-git": "^2.10.1",
      "gulp-less": "^5.0.0",
      "gulp-sass": "^5.1.0",
      "gulp-sourcemaps": "^3.0.0",
      "gulp-typescript": "^6.0.0-alpha.1",
      "gulp-uglify": "^3.0.2",
      "json-stringify-pretty-compact": "^3.0.0",
      "path": "^0.12.7",
      "prettier": "^2.7.1",
      "prettier-format": "^3.1.0",
      "readline-sync": "^1.4.10",
      "sass": "^1.49.11",
      "typescript": "^5.7.3",
      "yargs": "^17.1.1"
   }
}
